  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGIN": "https://masato-nasu.github.io", "VAPID_SUBJECT": "https://masato-nasu.github.io/TANGO-CHO2/"},
  "d1_databases": [{"binding": "DB", "database_name": "tangocho2-notifications", "database_id": "00000000-0000-0000-0000-000000000000"}],
